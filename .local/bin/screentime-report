#!/usr/bin/env bash
DIR="$HOME/.local/share/screentime"
range=${1:-1}
offset=${2:-0}   # 0 = start from today, 1 = start from yesterday

for ((i=6; i>=0; i--)); do
    d=$(date -d "-$i day" +%F)
    secs=0
    [ -f "$DIR/$d.log" ] && secs=$(awk -F'|' '{ s += ($2 == "" ? 10 : $2) } END { print s + 0 }' "$DIR/$d.log")
    printf 'DAY\t%s\t%s\n' "$d" "$secs"
done

# Read `range` days of logs, starting `offset` days back
for ((i=offset; i<offset+range; i++)); do
    f="$DIR/$(date -d "-$i day" +%F).log"
    [ -f "$f" ] && cat "$f"
done | awk -F'|' '{ t[$1] += ($2 == "" ? 10 : $2) } END { for (a in t) printf "APP\t%s\t%d\n", a, t[a] }' | sort -t$'\t' -k3,3nr | head -8
