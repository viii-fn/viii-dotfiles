#!/usr/bin/env bash
# viii-hypr-border: write Hyprland's window border colors (with gradient) from a palette.json
# usage: viii-hypr-border <path/to/palette.json>
#
# Active border   = gradient from borderFrom -> borderTo
#                   (palette keys; default wmActive -> accentHi)
# Inactive border = wmInactive (default: line), solid
#
# Optional env: VIII_BORDER_ANGLE=45   VIII_BORDER_ALPHA=ee
set -euo pipefail

pal="${1:?usage: viii-hypr-border <path/to/palette.json>}"
[ -f "$pal" ] || { echo "no palette: $pal" >&2; exit 1; }

OUT="$HOME/.config/hypr/viii-border.lua"
ANGLE="${VIII_BORDER_ANGLE:-45}"
ALPHA="${VIII_BORDER_ALPHA:-ee}"

# read one "key": "#rrggbb" value from the flat JSON (same trick as viii-wm-theme)
get() { sed -n "s/.*\"$1\": *\"\(#[0-9a-fA-F]\{6,8\}\)\".*/\1/p" "$pal" | head -n1; }
opt() { local v; v="$(get "$1")"; printf '%s' "${v:-$2}"; }
# keep the last 6 hex digits, so an 8-digit #AARRGGBB value loses its alpha prefix
rgb() { local h="${1#\#}"; printf '%s' "${h: -6}"; }

ACCENT=$(opt accent "#6cb4ff")
FROM=$(opt borderFrom "$(opt wmActive "$ACCENT")")
TO=$(opt borderTo "$(opt accentHi "$ACCENT")")
OFF=$(opt wmInactive "$(opt line "#2b4560")")

mkdir -p "$(dirname "$OUT")"
cat > "$OUT" <<EOF
-- generated by viii-hypr-border from $pal (do not edit by hand)
hl.config({
  general = {
    col = {
      active_border   = { colors = { "rgba($(rgb "$FROM")$ALPHA)", "rgba($(rgb "$TO")$ALPHA)" }, angle = $ANGLE },
      inactive_border = "rgba($(rgb "$OFF")aa)",
    },
  },
})
EOF

# apply it right now if Hyprland is running
if pgrep -x Hyprland >/dev/null 2>&1; then hyprctl reload >/dev/null 2>&1 || true; fi
echo "hypr border set from: $pal"
